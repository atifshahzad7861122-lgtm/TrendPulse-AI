# TrendPulse AI - Environment Configuration Example

# Security & App
SECRET_KEY=trendpulse-super-secret-development-key-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=development
CORS_ORIGINS=["https://trend-pulse-ai-three.vercel.app","http://localhost:5173"]
EMAIL_VERIFICATION_ENABLED=false

# Daraz Open Platform
DARAZ_APP_KEY=505830
DARAZ_APP_SECRET=your_daraz_app_secret_here

# Storage Backend & Database Configuration
DATA_BACKEND=in_memory
# For Supabase PostgreSQL, set:
# DATA_BACKEND=postgres
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_PROJECT_ID=your_supabase_project_id
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30.0
# DB_POOL_RECYCLE=1800

# Production YouTube Data Source
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_DATA_SOURCE_ENABLED=true
DATA_SOURCE_TIMEOUT_SECONDS=15.0
DATA_SOURCE_MAX_RETRIES=3
DATA_SOURCE_RETRY_BACKOFF_FACTOR=1.5
YOUTUBE_MAX_RESULTS=50
YOUTUBE_REGION_CODE=US
YOUTUBE_LANGUAGE=en

# Opt-in Integration Testing (default: false)
RUN_LIVE_YOUTUBE_TEST=false
SUPABASE_INTEGRATION_TEST=false

# LLM Intelligence Foundation Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=30
LLM_ENABLED=true
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=86400

# ScrapeGraphAI Scraper Provider Configuration
SCRAPEGRAPHAI_ENABLED=true
SCRAPEGRAPHAI_PROVIDER=groq
SCRAPEGRAPHAI_MODEL=groq/compound-mini
SCRAPEGRAPHAI_API_KEY=
SCRAPEGRAPHAI_HEADLESS=true
SCRAPEGRAPHAI_TIMEOUT=60.0

# Groq API Configuration
GROQ_API_KEY=


