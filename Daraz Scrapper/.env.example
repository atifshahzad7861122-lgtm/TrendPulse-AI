# ==============================================================================
# TrendPulse Daraz Scraper - Environment Configuration
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./scraper.db

# Network & Timeout Configuration (in seconds)
HTTP_TIMEOUT=30.0
BROWSER_TIMEOUT=60.0

# Concurrency & Retries
MAX_CONCURRENCY=5
MAX_RETRIES=3

# Rate Limiter Delays (in seconds)
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=3.0

# Crawl Checkpoint Settings (in processed items)
CHECKPOINT_INTERVAL=50

# Request Headers
SCRAPER_USER_AGENT=TrendPulse-DarazScraper/1.0 (+https://trendpulse.io/bot)

# Future Integration Placeholders
PROXY_URL=
PROXY_POOL=
DARAZ_BASE_URL=https://www.daraz.pk
SUPABASE_URL=
SUPABASE_KEY=
