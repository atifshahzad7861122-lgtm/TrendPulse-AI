# TrendPulse AI - Backend Environment Configuration Example
SECRET_KEY=trendpulse-super-secret-development-key-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=development

# Database & Supabase PostgreSQL Configuration
DATA_BACKEND=in_memory
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_DATABASE_PASSWORD]@[YOUR_SUPABASE_HOST]:5432/postgres
SUPABASE_PROJECT_ID=[YOUR_PROJECT_ID]
SUPABASE_INTEGRATION_TEST=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# YouTube Data API Configuration
YOUTUBE_API_KEY=[YOUR_YOUTUBE_API_KEY]
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_DATA_SOURCE_ENABLED=true
DATA_SOURCE_TIMEOUT_SECONDS=15.0
DATA_SOURCE_MAX_RETRIES=3
DATA_SOURCE_RETRY_BACKOFF_FACTOR=1.5
YOUTUBE_MAX_RESULTS=50
YOUTUBE_REGION_CODE=US
YOUTUBE_LANGUAGE=en

# Opt-in Live Data Testing
RUN_LIVE_YOUTUBE_TEST=false
